# Backend environment variables

# Port the server listens on (defaults to 3000 if not set)
PORT=3000

# CORS: restrict to your deployed frontend URL in production.
# Leave blank or set to * for local development (open to all origins).
CORS_ORIGIN=https://your-frontend-domain.com

# Set to 'true' ONLY in test environments to allow requests to localhost.
# Must NOT be set in production.
# ALLOW_LOCALHOST=true
